{
  "name": "lumenfall",
  "version": "1.0.3",
  "description": "Lumenfall - an idle RPG where Wisps push deeper into an ever-collapsing Rift.",
  "main": "desktop/main.js",
  "author": "karahaNx",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lumenfall.app",
    "productName": "Lumenfall",
    "files": [
      "index.html",
      "manifest.webmanifest",
      "service-worker.js",
      "icons/**/*",
      "desktop/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Lumenfall-Setup.exe"
    },
    "portable": {
      "artifactName": "Lumenfall-Portable.exe"
    }
  }
}
