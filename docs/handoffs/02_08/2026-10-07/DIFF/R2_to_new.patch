+function simulationWholeHpUnits(damage,maxHp){
+  // Binary long division of the represented Numbers, using only WebView 60
+  // APIs. A rounded D/H or (D-D%H)/H cannot decide an integer boundary.
+  if(!(damage>=0) || !(maxHp>0) || !Number.isFinite(damage) || !Number.isFinite(maxHp)) return Math.floor(damage/maxHp);
+  if(damage<maxHp) return 0;
+  var view = new DataView(new ArrayBuffer(16));
+  view.setFloat64(0,damage);
+  view.setFloat64(8,maxHp);
+  var dhi=view.getUint32(0),hhi=view.getUint32(8);
+  var de=(dhi>>>20)&2047,he=(hhi>>>20)&2047;
+  var dn=((dhi&1048575)+(de?1048576:0))*4294967296+view.getUint32(4);
+  var hn=((hhi&1048575)+(he?1048576:0))*4294967296+view.getUint32(12);
+  de=de?de-1075:-1074;
+  he=he?he-1075:-1074;
+  // At most 52 shifts per subnormal; ordinary physical HP needs none.
+  while(dn<4503599627370496){dn*=2;de--;}
+  while(hn<4503599627370496){hn*=2;he--;}
+  var shift=de-he;
+  // A shift above 53 implies an unsafe quotient. Preserve the existing
+  // out-of-contract Number result; this adds no cap on supported gameplay.
+  if(shift>53) return Math.floor(damage/maxHp);
+  var quotient=0;
+  // At most 54 bits for a safe quotient, never one iteration per kill.
+  // After subtraction dn<hn<=2^53-1. Doubling is exact (an even integer
+  // below 2^54); the next subtraction has an exactly representable result
+  // below hn. Every quotient prefix is exact when the final count is safe.
+  for(var bit=shift;bit>=0;bit--){
+    quotient*=2;
+    if(dn>=hn){dn-=hn;quotient++;}
+    if(bit>0) dn*=2;
+  }
+  return quotient;
+}
